#: zeugnisse/noten.py:164
msgid ""
"Jahrgangsstufe 9 im Bildungsgang ESA: Abschlussverfahren nach Sek I-PO – "
"Vorschlag nur zur Orientierung."
msgstr ""
"Year 9 in the ESA track: final examination under Sek I-PO – suggestion for "
"orientation only."

