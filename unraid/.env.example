# Konfiguration für den Betrieb auf Unraid. unraid/einrichten.sh erzeugt daraus die Datei unraid/.env
# mit zufälligen Passwörtern. Die .env enthält Geheimnisse – nicht weitergeben, nicht in Git einchecken.

SCHULNAME=Deutsche Schule Nairobi
SCHULORT=Nairobi
TIME_ZONE=Africa/Nairobi

# Ablageort aller Daten auf dem Unraid-Server (Datenbank, Dokumente, Sicherungen, Tailscale-Zustand).
# Empfehlung: Ordner auf dem Cache-Pool, z. B. /mnt/cache/appdata/edunex-daten
APPDATA=/mnt/user/appdata/edunex-daten

# Unraid-Standard: Benutzer nobody (99), Gruppe users (100)
PUID=99
PGID=100

# Port auf dem Unraid-Server. 8000 ist oft schon belegt (z. B. Paperless-ngx), daher 8010.
PORT=8010

# An welcher Adresse des Servers der Port geöffnet wird:
#   0.0.0.0       = im Heimnetz UND über Tailscale erreichbar (Voreinstellung)
#   100.x.y.z     = nur über Tailscale – hier die Tailscale-IP des Unraid-Servers eintragen
#                   (einrichten.sh bietet das an). Siehe Hinweis zum Neustart in ANLEITUNG-UNRAID.md
BIND_ADRESSE=0.0.0.0

# Sicherheit
SECRET_KEY=bitte-ersetzen
DEBUG=0
# Aufruf über Tailscale-Name, Tailscale-IP oder Heimnetz-IP: alle Hostnamen erlauben.
# Enger: z. B. ALLOWED_HOSTS=tower,tower.tail1234.ts.net,100.101.102.103
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=
# HTTPS (ab 0.4.6.0): auf 1 setzen, sobald die Seite über https aufgerufen wird (z. B. „tailscale serve“,
# siehe ANLEITUNG-UNRAID.md). Dann: Cookies nur per https, HSTS, Warnung beim Start entfällt.
# Die https-Adresse zusätzlich in CSRF_TRUSTED_ORIGINS eintragen, z. B. https://tower.tail1234.ts.net
HTTPS=0
# 1 = ein vorgeschalteter Proxy meldet https über den Kopf X-Forwarded-Proto (nur setzen, wenn sicher bekannt)
HINTER_PROXY=0
# 1 = Django leitet http auf https um (nur zusammen mit HINTER_PROXY=1, sonst Endlosschleife)
HTTPS_UMLEITUNG=0
# Wie lange sich Browser „nur https“ merken (Sekunden). Leer = 1 Jahr bei HTTPS=1. Zum Ausprobieren z. B. 3600.
HSTS_SEKUNDEN=

# Datenbank
DB_NAME=edunex
DB_BENUTZER=schule
DB_PASSWORT=bitte-ersetzen

# Tägliche Datenbanksicherung: Anzahl Tage, die Sicherungen aufbewahrt werden
SICHERUNG_BEHALTEN_TAGE=14

# Erstes Administrationskonto
ADMIN_BENUTZER=admin
ADMIN_PASSWORT=bitte-ersetzen

# Demo-Daten mit erfundenen Personen (1 = ja). Echte Schülerdaten erst nach Freigabe durch den Datenschutz!
DEMO_DATEN=1
DEMO_PASSWORT=bitte-ersetzen

# Jahrgänge der Stufen (Stufenkoordination)
MITTELSTUFE=5-10
OBERSTUFE=11-12

# Fehltage auf dem Zeugnis ausweisen (im KMK-Muster nicht vorgesehen): 1 = ja
ZEUGNIS_FEHLZEITEN=0

# Höchstgröße je Anhang in MB
DOKUMENT_MAX_MB=25

# ---------------------------------------------------------------- Elternkommunikation (ab 0.4.2.9)
# E-Mail-Versand an Eltern: 0 = aus (Nachrichten bleiben im Postausgang), 1 = an.
# Echte Elternadressen erst nach Freigabe durch den Datenschutz verwenden!
ELTERN_EMAIL_VERSAND=0
# Öffentliche Adresse, unter der Eltern ihren persönlichen Link öffnen (https!).
# Eine reine Tailscale-Adresse ist für Eltern NICHT erreichbar.
ELTERN_LINK_BASIS=https://edunex.example.org
# Gültigkeit der Links in Tagen
ELTERN_LINK_TAGE=60
# Nachrichtentext zusätzlich in die E-Mail schreiben (0 = nur Hinweis und Link, datensparsamer)
ELTERN_EMAIL_INHALT=0
# Elternportal mit eigener Anmeldung – erst nach Zwei-Faktor-Anmeldung und Datenschutzfreigabe auf 1 setzen
ELTERNPORTAL_AKTIV=0
# Postausgangsserver (SMTP), z. B. Microsoft 365: smtp.office365.com, Port 587, TLS
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Deutsche Schule Nairobi <edunex@example.org>

# ---------------------------------------------------------------- Sicherung und PDF-Export (ab 0.4.3.0)
# Höchstgröße hochgeladener Sicherungsdateien in MB
SICHERUNG_UPLOAD_MAX_MB=500
# Anzahl automatischer Modulsicherungen (manage.py modulsicherung), die aufbewahrt werden
SICHERUNG_BEHALTEN_AUTOMATISCH=14
# Höchstzahl Einträge je PDF-Datei; mehr werden auf mehrere Dateien verteilt
PDF_EINTRAEGE_JE_DATEI=1500

# ---------------------------------------------------------------- Verschlüsselung und Office (ab 0.4.6.0)
# Schlüssel für Anhänge, Bewerbungsunterlagen, Modulsicherungen und PDF-Exporte (AES-256).
# Wird beim ersten Einrichten automatisch erzeugt. Neu erzeugen: docker compose exec web python manage.py schluessel_erzeugen
# WICHTIG: Den Schlüssel zusätzlich getrennt vom Server aufbewahren (ausgedruckt im Tresor).
# Ohne ihn sind verschlüsselte Dateien und Sicherungen NICHT mehr lesbar. Nie ändern, solange Dateien damit verschlüsselt sind.
DATEN_SCHLUESSEL=
# Microsoft-365-Mandant: Name vor „.sharepoint.com“ (z. B. dsnairobi für https://dsnairobi.sharepoint.com).
# Nur nötig für Office-Kacheln mit dem Platzhalter {mandant}.
OFFICE_MANDANT=

# ---------------------------------------------------------------- Noten (ab 0.4.8.0)
# Jahresnote: In diesen Jahrgängen zählt das 1. Halbjahr im Vorschlag des 2. Halbjahres mit diesem Anteil (%).
# Die Lehrkraft kann den Anteil je Kurs ändern.
JAHRESNOTE_JAHRGAENGE=5-10
JAHRESNOTE_ANTEIL_HJ1=40
