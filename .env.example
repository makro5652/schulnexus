# Vorlage für die Konfiguration. start.sh erzeugt daraus automatisch eine .env
# mit zufälligen Passwörtern. Die .env NIEMALS in Git einchecken.

SCHULNAME=Deutsche Schule Nairobi
SCHULORT=Nairobi
TIME_ZONE=Africa/Nairobi

# Sicherheit
SECRET_KEY=bitte-ersetzen
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Erst auf 1 setzen, wenn die Seite per HTTPS läuft
SECURE_COOKIES=0

# Datenbank
DB_NAME=schulverwaltung
DB_BENUTZER=schule
DB_PASSWORT=bitte-ersetzen

# Erstes Administrationskonto (wird beim Start angelegt, falls nicht vorhanden)
ADMIN_BENUTZER=admin
ADMIN_PASSWORT=bitte-ersetzen

# Demo-Daten mit erfundenen Personen laden (1 = ja). Auf Systemen mit echten Daten: 0
DEMO_DATEN=1
DEMO_PASSWORT=bitte-ersetzen

# Jahrgänge der Stufen (Stufenkoordination)
MITTELSTUFE=5-10
OBERSTUFE=11-12

# Fehltage auf dem Zeugnis ausweisen (im KMK-Muster nicht vorgesehen): 1 = ja
ZEUGNIS_FEHLZEITEN=0

# Höchstgröße je Anhang in MB
DOKUMENT_MAX_MB=25

# Port auf dem Rechner
PORT=8000

# ---------------------------------------------------------------- Elternkommunikation (ab 0.4.2.9)
# E-Mail-Versand an Eltern: 0 = aus (Nachrichten bleiben im Postausgang), 1 = an.
# Echte Elternadressen erst nach Freigabe durch den Datenschutz verwenden!
ELTERN_EMAIL_VERSAND=0
# Öffentliche Adresse, unter der Eltern ihren persönlichen Link öffnen (https!).
# Eine reine Tailscale-Adresse ist für Eltern NICHT erreichbar.
ELTERN_LINK_BASIS=https://schulverwaltung.example.org
# Gültigkeit der Links in Tagen
ELTERN_LINK_TAGE=60
# Nachrichtentext zusätzlich in die E-Mail schreiben (0 = nur Hinweis und Link, datensparsamer)
ELTERN_EMAIL_INHALT=0
# Elternportal mit eigener Anmeldung – erst nach Zwei-Faktor-Anmeldung und Datenschutzfreigabe auf 1 setzen
ELTERNPORTAL_AKTIV=0
# Postausgangsserver (SMTP), z. B. Microsoft 365: smtp.office365.com, Port 587, TLS
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Deutsche Schule Nairobi <schulverwaltung@example.org>

# ---------------------------------------------------------------- Sicherung und PDF-Export (ab 0.4.3.0)
# Höchstgröße hochgeladener Sicherungsdateien in MB
SICHERUNG_UPLOAD_MAX_MB=500
# Anzahl automatischer Modulsicherungen (manage.py modulsicherung), die aufbewahrt werden
SICHERUNG_BEHALTEN_AUTOMATISCH=14
# Höchstzahl Einträge je PDF-Datei; mehr werden auf mehrere Dateien verteilt
PDF_EINTRAEGE_JE_DATEI=1500
